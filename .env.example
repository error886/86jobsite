# Copy to .env and fill in real values. Never commit .env.

# Comma-separated Google emails that get admin rights (checked on the server)
ADMIN_EMAILS=

# Local test accounts for development: 1 shows "Admin test" / "Du học sinh test" in the login dialog.
# Ignored when NODE_ENV=production. Never set on a real server.
DEV_AUTH=

# AI parser (optional; falls back to the local regex parser)
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# Public Kakao Map JS key (exposed to the browser)
VITE_KAKAO_MAP_KEY=

# Folder for the local db.json fallback (e.g. /app/data on Coolify)
DATA_PATH=

# Supabase (primary database)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# Optional: override the Firebase project id from firebase-applet-config.json
FIREBASE_PROJECT_ID=
