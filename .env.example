# OPENROUTER_API_KEY: Optional API key for OpenRouter AI model provider (e.g. sk-or-v1-...)
OPENROUTER_API_KEY=""

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL=""

# VITE_KAKAO_MAP_APP_KEY: Kakao Map JavaScript Key (from developers.kakao.com)
VITE_KAKAO_MAP_APP_KEY=""

# VITE_NAVER_MAP_CLIENT_ID: Optional Naver Map OpenAPI v3 Client ID (ncpClientId)
VITE_NAVER_MAP_CLIENT_ID=""

# --- COOLIFY & PRODUCTION DEPLOYMENT CONFIGURATIONS ---

# DATA_PATH: Optional directory where the local database (db.json) will be stored.
# If you want to persist the database on Coolify, set this to a folder (e.g. /app/data)
# and mount a persistent volume to that folder in Coolify.
DATA_PATH=""

# FIREBASE CONFIGURATIONS:
# Use these if you want to deploy onto Coolify while connecting to your Firebase Firestore database.
# If these are left blank, the app automatically falls back to local JSON database storage (db.json).
FIREBASE_PROJECT_ID=""
FIREBASE_DATABASE_ID=""

# FIREBASE_SERVICE_ACCOUNT:
# The complete Firebase Service Account JSON string (e.g. {"type": "service_account", ...})
# so the application can authenticate with Firestore from outside Google Cloud.
# If left blank, the app automatically falls back to local JSON database storage (db.json).
FIREBASE_SERVICE_ACCOUNT=""

# SUPABASE CONFIGURATIONS:
# Use these if you want to store your data in a Supabase database.
# If these are left blank, the app will fall back to local db.json.
SUPABASE_URL=""
SUPABASE_KEY=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SECRET_KEY=""
SUPABASE_JWKS_URL=""

